# MyInventory local development (copied to .env.development by `pnpm dev:setup`).
# Local machine only. Never put production credentials in this file: every
# development and database command refuses non-local databases anyway.

NODE_ENV=development
# 5001, not 5000: macOS AirPlay Receiver listens on port 5000. To use 5000,
# turn off System Settings > General > AirDrop & Handoff > AirPlay Receiver.
PORT=5001

# PostgreSQL on this machine (no password needed with Homebrew's default local trust)
DATABASE_URL=postgresql://localhost:5432/myinventory_dev

# Photos for local development, separate from ./uploads
LOCAL_STORAGE_DIR=./uploads-dev

# Mock AI: deterministic responses, no OpenAI calls. The key below is a
# non-secret placeholder that only satisfies start-up validation.
ANALYZER_PROVIDER=mock
OPENAI_API_KEY=mock-analyzer-no-key-required

# Development-only session secret. INVENTORY_PASSWORD is deliberately unset,
# so sign-in is disabled locally (it is required in production).
SESSION_SECRET=local-development-only-not-secret
