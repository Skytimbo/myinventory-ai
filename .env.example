# MyInventory AI Environment Variables
# Railway-ready configuration

# ===========================================
# Required for all environments
# ===========================================

# PostgreSQL Database connection
DATABASE_URL=postgresql://user:password@host:5432/database

# OpenAI API key for AI-powered image analysis
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Project ID (required for project-scoped keys starting with sk-proj-*)
# Find at: https://platform.openai.com/settings/organization/projects
# Leave blank if using user-scoped keys (sk-...)
OPENAI_PROJECT_ID=

# Session secret for Express session middleware
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
SESSION_SECRET=your-generated-session-secret-here

# ===========================================
# Optional configuration
# ===========================================

# Server port (default: 5000)
PORT=5000

# Node environment (development, production, api-only)
# api-only = headless API server for E2E testing with separate Vite dev server
NODE_ENV=development

# Local storage directory for uploaded images
# For development: use ./uploads
# For Railway: use /app/uploads (persistent volume mount path)
LOCAL_STORAGE_DIR=./uploads

# Override OpenAI API base URL (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Analyzer provider: "openai" (default) or "mock" (skip AI in development/testing)
# ANALYZER_PROVIDER=openai

# Allowed CORS origin in production (default: same origin)
# CORS_ORIGIN=https://your-domain.com

# Cloudflare Tunnel for mobile testing (optional)
# Set to "true" to auto-start tunnel with pnpm dev:mobile
ENABLE_TUNNEL=false

# ===========================================
# Railway deployment notes
# ===========================================
#
# 1. Set these variables in Railway dashboard:
#    - DATABASE_URL (auto-injected by PostgreSQL plugin)
#    - OPENAI_API_KEY (add manually)
#    - OPENAI_PROJECT_ID (required if using sk-proj-* keys)
#    - SESSION_SECRET (generate new one)
#    - LOCAL_STORAGE_DIR=/app/uploads
#    - NODE_ENV=production
#    - PORT=5000
#
# 2. Add persistent volume:
#    - Mount path: /app/uploads
#    - Size: 5 GB (adjust as needed)
#
# 3. Deploy with: git push (Railway auto-deploys from GitHub)
#
